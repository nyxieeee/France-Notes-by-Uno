# ============================================================
# France Notes — Environment Variables
# ============================================================
# Copy this file to .env and fill in your keys for local dev.
# NEVER commit .env to git — it's already in .gitignore.
#
# 🔒 SECURITY: For production (Vercel), set these exact same
#    variable names in the Vercel Dashboard:
#    Project Settings → Environment Variables
#    They will be used server-side by /api/* proxy functions
#    and NEVER exposed to the browser.
# ============================================================

# ── Groq (https://console.groq.com/keys) ────────────────────
# Used for: Doc Uno chat, Quiz, RetDem, Recitation, Vision/Scanner
VITE_GROQ_API_KEY=your_groq_api_key_here

# ── Mistral (https://console.mistral.ai/api-keys) ───────────
# Used for: Reviewer generation, PPT generation, Document processing, Nursepod Podcast
# Free tier: 1 billion tokens/month — no credit card needed, phone verify only
VITE_MISTRAL_API_KEY=your_mistral_api_key_here

# ── Gemini (https://aistudio.google.com/app/apikey) ─────────
# Used for: Fun Facts, Knowledge Garden (grounded search)
# Free tier: 1,000 req/day on gemini-2.5-flash-lite
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ── ElevenLabs Text-to-Speech (https://elevenlabs.io/app/speech-synthesis) ──
# Used for: Doc Uno & Nurse Florence voice in RetDem, Recitation, and Nursepod Podcast
# Default voices: Adam (Doc Uno) + Rachel (Nurse Florence) via Turbo v2.5
# Free tier: 10,000 characters/month
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional: override default ElevenLabs voice IDs
# VITE_ELEVENLABS_VOICE_DOC_UNO=pNInz6obpgDQGcFmaJgB
# VITE_ELEVENLABS_VOICE_NURSE_FLORENCE=EXAVITQu4vr4xnSDxMaL

# ── Supabase (https://supabase.com/dashboard) ───────────────
# Used for: Authentication, User Profiles, Saved Quizzes, Podcast Episodes, Dosage History & Saved Labs
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
